# Copiar a .env y ajustar valores. .env nunca se commitea.

# --- Postgres ---
POSTGRES_USER=expensetrack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=expensetrack
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+psycopg://expensetrack:changeme@db:5432/expensetrack
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Login con Google (opcional) ---
# Sin estas dos variables, /auth/oauth/google/start responde 503 y el botón
# "Continuar con Google" no funciona; el resto de la app sigue igual.
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# y registrar GOOGLE_REDIRECT_URI como URI de redirección autorizada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
FRONTEND_BASE_URL=http://localhost:5173

# --- Adjuntos ---
ATTACHMENTS_DIR=/app/storage/attachments

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
